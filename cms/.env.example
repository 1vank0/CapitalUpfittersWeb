# Local-only staging. Supply a private random 32+ character value; never commit it.
PAYLOAD_SECRET=
CMS_DEPLOYMENT_SCOPE=local
CMS_SERVER_URL=http://localhost:3100
# Defaults to isolated local SQLite. No existing lead database is ever selected.
CMS_DATABASE_URL=
# Preview hosting REQUIRES a dedicated PostgreSQL database and approved Blob store.
CMS_BLOB_READ_WRITE_TOKEN=
CMS_ASSET_ORIGIN=
# Keep off until this public projection is approved for consumption.
CMS_PUBLIC_READS_ENABLED=false
# No seed data, production hook or real account is configured automatically.
